<Project>

  <!--
    Strong naming for every project of BaGet.sln (src, tests, samples). SignKey.snk is in the repository (a
    checkout without it at the root cannot build). src/ and tests/ Directory.Build.props
    import this file, because MSBuild reads only the nearest Directory.Build.props.
  -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)SignKey.snk</AssemblyOriginatorKeyFile>
    <!-- Full public key of SignKey.snk: the Key of every <InternalsVisibleTo>. -->
    <BaGetPublicKey></BaGetPublicKey>
  </PropertyGroup>

</Project>
