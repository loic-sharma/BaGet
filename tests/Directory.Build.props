<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <!-- dotnet test runs these on Microsoft.Testing.Platform (global.json "test.runner"); there is no VSTest adapter. -->
  </PropertyGroup>

  <PropertyGroup>
    <DebugType>portable</DebugType>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <!-- NuGet dependencies shared across projects -->
  <PropertyGroup>
    <MicrosoftAspNetCorePackageVersion>8.0.0</MicrosoftAspNetCorePackageVersion>
    <NewtonsoftJsonPackageVersion>13.0.3</NewtonsoftJsonPackageVersion>
    <NuGetPackageVersion>6.10.0</NuGetPackageVersion>
    <XUnitPackageVersion>4.0.2</XUnitPackageVersion>
    <JintPackageVersion>4.2.0</JintPackageVersion>
    <TestcontainersPackageVersion>4.16.0</TestcontainersPackageVersion>
    <MicrosoftCodeAnalysisCSharpPackageVersion>4.14.0</MicrosoftCodeAnalysisCSharpPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3" Version="$(XUnitPackageVersion)" />
  </ItemGroup>
</Project>
