<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real package-manager CLIs (npm now; mvn and docker:dind in later phases) run in containers; the tests skip without a Docker daemon. -->
    <PackageReference Include="Testcontainers" Version="$(TestcontainersPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real application, started on a real socket, is what the CLIs talk to. -->
    <ProjectReference Include="..\..\src\BaGet\BaGet.csproj" />
  </ItemGroup>

</Project>
