@model BaGet.Identity.Application.Models.Settings.AdminSettingsViewModel
@{
    ViewData["Title"] = "Server settings";
}

<div class="col-sm-12">
    <h1>Server settings</h1>
    <hr class="breadcrumb-divider" />
    <p class="text-muted">Saved to <code>@Model.OverridesPath</code>. Environment variables and command-line arguments override saved values.</p>

    @if (Model.LoadError != null)
    {
        <div class="alert alert-danger" role="alert" id="settings-load-error">@Model.LoadError</div>
    }
    @if (Model.Message != null)
    {
        <div class="alert alert-success" role="alert" id="settings-message">@Model.Message</div>
    }
    @if (Model.PendingRestart.Count > 0)
    {
        <div class="alert alert-warning" role="alert" id="settings-restart">Restart BaGet to apply: @string.Join(", ", Model.PendingRestart)</div>
    }

    @if (Model.CopyStatus.Phase != BaGet.Core.DatabaseCopyPhase.Idle)
    {
        var copy = Model.CopyStatus;
        <div class="alert @(copy.Phase == BaGet.Core.DatabaseCopyPhase.Failed ? "alert-danger" : copy.Phase == BaGet.Core.DatabaseCopyPhase.Succeeded ? "alert-warning" : "alert-info")"
             role="status" id="copy-status" data-active="@(copy.IsActive ? "true" : "false")">
            <strong>Database copy: <span data-copy-phase>@copy.Phase</span></strong>
            <div data-copy-message>@copy.Message</div>
            <div data-copy-progress>@(copy.Phase == BaGet.Core.DatabaseCopyPhase.Copying ? $"{copy.Table}: {copy.TableRowsCopied} of {copy.TableRowsTotal} rows; {copy.RowsCopied} of {copy.RowsTotal} in all." : "")</div>
            <ul data-copy-errors>@foreach (var e in copy.Errors) { <li>@e</li> }</ul>
            <div data-copy-restart @(copy.RestartRequired ? "" : "hidden")><strong>Restart BaGet now</strong> to use the new database. Until then every write is refused.</div>
        </div>
    }

    <div class="row">
        <nav class="col-md-3">
            <ul class="nav nav-pills nav-stacked settings-nav">
                @foreach (var s in Model.Sections)
                {
                    var navId = Model.SectionId(s.Key);
                    var current = navId == Model.SelectedId;
                    <li class="@(current ? "active" : "")" data-section-item="@navId"><a href="?section=@navId#@navId" data-section-link="@navId" aria-controls="@navId" aria-current="@(current ? "page" : "false")">@(s.Key.Length == 0 ? "General" : s.Key)</a></li>
                }
            </ul>
        </nav>
        <div class="col-md-9" id="settings-sections" data-selected="@Model.SelectedId" data-locked="@(Model.SelectionLocked ? "true" : "false")">
            @foreach (var s in Model.Sections)
            {
                var title = s.Key.Length == 0 ? "General" : s.Key;
                var formId = Model.SectionId(s.Key);
                <form method="post" id="@formId" class="panel panel-default" data-section-panel="@formId" hidden="@(formId != Model.SelectedId)">
                    <div class="panel-heading">
                        <strong>@title</strong>
                        <a class="pull-right" href="@BaGet.Core.SettingsCatalog.DocsAnchor(s.Key)" target="_blank" rel="noopener">Docs</a>
                    </div>
                    <div class="panel-body">
                        @if (Model.ErrorSection == s.Key)
                        {
                            <div class="alert alert-danger" role="alert"><ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
                        }
                        @if (string.Equals(s.Key, "Telemetry", StringComparison.OrdinalIgnoreCase) && !Model.HostExportsTelemetry)
                        {
                            <div class="alert alert-info" role="note" id="telemetry-no-host">This host doesn't export telemetry; these settings have no effect here (they apply to a host that does and shares this settings file).</div>
                        }
                        @if (string.Equals(s.Key, "Telemetry", StringComparison.OrdinalIgnoreCase) && Model.TelemetrySignals != null)
                        {
                            <table class="table table-condensed" id="telemetry-status">
                                <thead><tr><th>Signal</th><th>Export status</th></tr></thead>
                                <tbody>
                                    @foreach (var signal in Model.TelemetrySignals)
                                    {
                                        <tr data-signal="@signal.Signal" data-state="@signal.State">
                                            <td>@signal.Signal</td>
                                            <td>
                                                @switch (signal.State)
                                                {
                                                    case BaGet.Core.TelemetrySignalState.Off:
                                                        <span class="text-muted">Off</span>
                                                        break;
                                                    case BaGet.Core.TelemetrySignalState.NotConfigured:
                                                        <span class="text-muted">Not configured (no endpoint set)</span>
                                                        break;
                                                    case BaGet.Core.TelemetrySignalState.Waiting:
                                                        <span>Configured, nothing exported yet</span>
                                                        break;
                                                    case BaGet.Core.TelemetrySignalState.Ok:
                                                        <span class="text-success">Last export ok at @signal.LastSuccess?.UtcDateTime.ToString("u")</span>
                                                        break;
                                                    default:
                                                        <span class="text-danger">Failing since @signal.FailingSince?.UtcDateTime.ToString("u")</span>
                                                        @if (!string.IsNullOrEmpty(signal.LastError)) { <div data-error>@signal.LastError</div> }
                                                        break;
                                                }
                                                @if (signal.Dropped > 0) { <div class="text-warning">@signal.Dropped dropped (queue full)</div> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (Model.TelemetryTest != null)
                            {
                                <div class="alert @(Model.TelemetryTest.Ok ? "alert-success" : "alert-danger")" role="status" id="telemetry-test-result">
                                    <strong>@(Model.TelemetryTest.Ok ? "Connection ok" : "Connection failed")</strong>
                                    @if (!string.IsNullOrEmpty(Model.TelemetryTest.Target)) { <span>(<code>@Model.TelemetryTest.Target</code>)</span> }
                                    <div>@Model.TelemetryTest.Message</div>
                                    <div class="small">Tested with the values in the form. Nothing was saved.</div>
                                </div>
                            }
                        }
                        @foreach (var g in s.GroupBy(x => x.Descriptor.Group))
                        {
                            <fieldset>
                                <legend>@g.Key</legend>
                                @foreach (var f in g)
                                {
                                    ViewData["Siblings"] = s;
                                    <partial name="~/Views/Shared/_SettingField.cshtml" model="f" view-data="ViewData" />
                                }
                            </fieldset>
                        }
                        @if (string.Equals(s.Key, "Database", StringComparison.OrdinalIgnoreCase) && Model.CanCopyDatabase)
                        {
                            <div class="checkbox" id="copy-option" data-target-types="@string.Join(",", Model.CopyTargetTypes)">
                                <label>
                                    <input type="checkbox" name="copyData" value="true" checked="checked" />
                                    Copy all data to the new database
                                </label>
                                <p class="help-block">
                                    When you change the database type or connection string, the target's schema is created, every row is
                                    copied into it (it must be empty) and only then are the settings saved. The server is read-only from
                                    the start of the copy until you restart it. Package files are not copied: they stay in Storage.
                                </p>
                            </div>
                        }
                        <input type="hidden" name="section" value="@s.Key" />
                        @if (Model.HasPassword)
                        {
                            <div class="form-group">
                                <label>Your password</label>
                                <input type="password" name="password" class="form-control" autocomplete="current-password" required />
                            </div>
                        }
                        else
                        {
                            <partial name="~/Views/Shared/_Reauthenticate.cshtml" model="@(new ReauthenticateView(Model.Reauthenticated, Model.CanReauthenticate, "/Admin/Settings"))" />
                        }
                        <button type="submit" class="btn btn-primary">Save @title</button>
                        @if (string.Equals(s.Key, "Telemetry", StringComparison.OrdinalIgnoreCase) && Model.TelemetrySignals != null)
                        {
                            <button type="submit" class="btn btn-default" id="telemetry-test" formaction="?handler=TestTelemetry#@formId">Test connection</button>
                        }
                    </div>
                </form>
                @if (string.Equals(s.Key, "Serilog", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="panel panel-default" id="log-levels" data-section-panel="@formId" hidden="@(formId != Model.SelectedId)">
                        <div class="panel-heading"><strong>Log levels per source</strong></div>
                        <div class="panel-body">
                            <p class="help-block">
                                The lowest level logged for one namespace or type name prefix (<code>Serilog:MinimumLevel:Override</code>); applies at once.
                                A source without an entry uses the default level above. Sinks (where the log is written) are set in the configuration file.
                            </p>
                            @if (Model.LogLevels.Count == 0)
                            {
                                <p class="text-muted" id="log-levels-empty">No source has a level of its own.</p>
                            }
                            else
                            {
                                <table class="table table-condensed" id="log-levels-table">
                                    <thead><tr><th>Source</th><th>Level</th><th>Set by</th><th></th></tr></thead>
                                    <tbody>
                                    @foreach (var entry in Model.LogLevels)
                                    {
                                        <tr data-log-source="@entry.Source">
                                            <td><code>@entry.Source</code></td>
                                            <td>@entry.Level</td>
                                            <td>@(entry.InOverridesFile ? "this page" : "configuration file or environment")</td>
                                            <td>
                                                @if (entry.InOverridesFile)
                                                {
                                                    <form method="post" asp-controller="AdminSettings" asp-action="Index" asp-route-handler="RemoveLogLevel" class="form-inline">
                                                        <input type="hidden" name="source" value="@entry.Source" />
                                                        @if (Model.HasPassword)
                                                        {
                                                            <input type="password" name="password" class="form-control input-sm" placeholder="Your password" autocomplete="current-password" required />
                                                        }
                                                        <button type="submit" class="btn btn-danger btn-xs log-level-remove">Remove</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            }
                            <form method="post" asp-controller="AdminSettings" asp-action="Index" asp-route-handler="SetLogLevel" class="form-inline" id="log-level-form">
                                <div class="form-group">
                                    <label for="log-level-source">Source</label>
                                    <input id="log-level-source" name="source" class="form-control" placeholder="Microsoft.AspNetCore" maxlength="@BaGet.Core.LogLevelOverrides.MaxSourceLength" required />
                                </div>
                                <div class="form-group">
                                    <label for="log-level-level">Level</label>
                                    <select id="log-level-level" name="level" class="form-control">
                                        @foreach (var name in Model.LogLevelNames) { <option value="@name">@name</option> }
                                    </select>
                                </div>
                                @if (Model.HasPassword)
                                {
                                    <div class="form-group">
                                        <label for="log-level-password">Your password</label>
                                        <input id="log-level-password" type="password" name="password" class="form-control" autocomplete="current-password" required />
                                    </div>
                                }
                                else
                                {
                                    <partial name="~/Views/Shared/_Reauthenticate.cshtml" model="@(new ReauthenticateView(Model.Reauthenticated, Model.CanReauthenticate, "/Admin/Settings"))" />
                                }
                                <button type="submit" class="btn btn-primary" id="log-level-save">Set level</button>
                            </form>
                        </div>
                    </div>
                }
                @if (string.Equals(s.Key, "Accounts", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="panel panel-default" id="sign-in-providers" data-section-panel="@formId" hidden="@(formId != Model.SelectedId)">
                        <div class="panel-heading"><strong>Sign-in providers</strong></div>
                        <div class="panel-body">
                            <p class="help-block">
                                Named OpenID Connect providers (<code>Accounts:OpenIdConnectProviders:&lt;id&gt;</code>), each with its own button on the sign-in page; the callback is
                                <code>/signin-oidc-&lt;id&gt;</code>. The id cannot change once created. A blank client secret keeps the saved one. Providers are registered at
                                startup, so a change applies after a restart. <strong>A provider with an administrator claim decides who is an administrator for the users who sign in through it.</strong>
                            </p>
                            @if (Model.SignInProviders.Count == 0)
                            {
                                <p class="text-muted" id="sign-in-providers-empty">No named provider is configured.</p>
                            }
                            else
                            {
                                <table class="table table-condensed" id="sign-in-providers-table">
                                    <thead><tr><th>Id</th><th>Name</th><th>Authority</th><th>Status</th><th></th></tr></thead>
                                    <tbody>
                                    @foreach (var provider in Model.SignInProviders)
                                    {
                                        <tr data-provider-id="@provider.Id">
                                            <td><code>@provider.Id</code></td>
                                            <td>@provider.DisplayName</td>
                                            <td>@provider.Authority</td>
                                            <td>
                                                @(provider.PendingRestart ? "Restart to apply" : provider.Active ? "Active" : "Not active")
                                                @if (!provider.Editable) { <span class="text-muted">(configuration file or environment)</span> }
                                            </td>
                                            <td>
                                                @if (provider.Editable)
                                                {
                                                    <form method="post" asp-controller="AdminSettings" asp-action="Index" asp-route-handler="RemoveProvider" class="form-inline">
                                                        <input type="hidden" name="id" value="@provider.Id" />
                                                        @if (Model.HasPassword)
                                                        {
                                                            <input type="password" name="password" class="form-control input-sm" placeholder="Your password" autocomplete="current-password" required />
                                                        }
                                                        <button type="submit" class="btn btn-danger btn-xs provider-remove">Remove</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            }

                            @foreach (var p in Model.SignInProviders.Where(x => x.Editable).Append(new BaGet.Identity.Application.Models.Settings.SignInProviderView()))
                            {
                                var isNew = string.IsNullOrEmpty(p.Id);
                                var key = isNew ? "new" : p.Id;
                                <details @(isNew ? "" : "open") class="sign-in-provider-form" data-provider-form="@key">
                                    <summary><strong>@(isNew ? "Add a provider" : "Edit " + p.Id)</strong></summary>
                                    <form method="post" asp-controller="AdminSettings" asp-action="Index" asp-route-handler="SaveProvider">
                                        <div class="form-group">
                                            <label for="provider-id-@key">Id</label>
                                            @if (isNew)
                                            {
                                                <input id="provider-id-@key" name="id" class="form-control" pattern="[a-z0-9-]{1,32}" maxlength="32" placeholder="entra" required />
                                            }
                                            else
                                            {
                                                <input id="provider-id-@key" name="id" class="form-control" value="@p.Id" readonly />
                                            }
                                        </div>
                                        <div class="form-group"><label for="provider-name-@key">Button name</label><input id="provider-name-@key" name="displayName" class="form-control" value="@p.DisplayName" /></div>
                                        <div class="form-group"><label for="provider-authority-@key">Authority</label><input id="provider-authority-@key" name="authority" class="form-control" value="@p.Authority" placeholder="https://login.example.com/tenant/v2.0" required /></div>
                                        <div class="form-group"><label for="provider-client-@key">Client id</label><input id="provider-client-@key" name="clientId" class="form-control" value="@p.ClientId" required /></div>
                                        <div class="form-group">
                                            <label for="provider-secret-@key">Client secret</label>
                                            <input id="provider-secret-@key" name="clientSecret" type="password" class="form-control" autocomplete="new-password" placeholder="@(p.HasSecret ? "Set - leave blank to keep it" : "")" />
                                        </div>
                                        <div class="form-group"><label for="provider-scopes-@key">Extra scopes</label><input id="provider-scopes-@key" name="scopes" class="form-control" value="@p.Scopes" placeholder="groups offline_access" /></div>
                                        <div class="form-group"><label for="provider-parameters-@key">Extra request parameters (name=value per line)</label><textarea id="provider-parameters-@key" name="parameters" class="form-control" rows="2" placeholder="domain_hint=example.com">@p.Parameters</textarea></div>
                                        <div class="form-group"><label for="provider-username-@key">User name claim</label><input id="provider-username-@key" name="userNameClaim" class="form-control" value="@p.UserNameClaim" placeholder="preferred_username" /></div>
                                        <div class="form-group"><label for="provider-email-@key">Email claim</label><input id="provider-email-@key" name="emailClaim" class="form-control" value="@p.EmailClaim" placeholder="email" /></div>
                                        <div class="form-group"><label for="provider-verified-@key">Email verified claim</label><input id="provider-verified-@key" name="emailVerifiedClaim" class="form-control" value="@p.EmailVerifiedClaim" placeholder="email_verified" /></div>
                                        <div class="form-group"><label for="provider-adminclaim-@key">Administrator claim</label><input id="provider-adminclaim-@key" name="administratorClaim" class="form-control" value="@p.AdministratorClaim" placeholder="roles" /></div>
                                        <div class="form-group">
                                            <label for="provider-adminvalue-@key">Administrator value</label>
                                            <input id="provider-adminvalue-@key" name="administratorValue" class="form-control" value="@p.AdministratorValue" placeholder="baget-admin" />
                                            <p class="help-block">When both are set, this provider decides the administrator flag of the users who sign in through it: present promotes, absent demotes (never the last administrator).</p>
                                        </div>
                                        <div class="form-group"><label for="provider-groupclaim-@key">Group claim</label><input id="provider-groupclaim-@key" name="groupClaim" class="form-control" value="@p.GroupClaim" placeholder="groups" /></div>
                                        <div class="form-group"><label for="provider-groups-@key">Group mappings (claim value=BaGet group per line)</label><textarea id="provider-groups-@key" name="groupMappings" class="form-control" rows="2" placeholder="developers=Developers">@p.GroupMappings</textarea></div>
                                        @if (Model.HasPassword)
                                        {
                                            <div class="form-group">
                                                <label for="provider-password-@key">Your password</label>
                                                <input id="provider-password-@key" type="password" name="password" class="form-control" autocomplete="current-password" required />
                                            </div>
                                        }
                                        else
                                        {
                                            <partial name="~/Views/Shared/_Reauthenticate.cshtml" model="@(new ReauthenticateView(Model.Reauthenticated, Model.CanReauthenticate, "/Admin/Settings"))" />
                                        }
                                        <button type="submit" class="btn btn-primary provider-save">@(isNew ? "Add provider" : "Save " + p.Id)</button>
                                    </form>
                                </details>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Shows one section at a time. The server already rendered the right one (failed save, connection test,
        // ?section=, else the first); this makes the nav switch without a reload and honours the URL fragment.
        // Without JavaScript the nav links are plain ?section= links. Attributes only (hidden, class, aria-current).
        (function () {
            var host = document.getElementById('settings-sections');
            if (!host) return;

            var panels = host.querySelectorAll('[data-section-panel]');
            var items = document.querySelectorAll('.settings-nav [data-section-item]');

            function exists(id) {
                for (var i = 0; i < panels.length; i++) if (panels[i].getAttribute('data-section-panel') === id) return true;
                return false;
            }

            function show(id) {
                panels.forEach(function (panel) {
                    if (panel.getAttribute('data-section-panel') === id) panel.removeAttribute('hidden');
                    else panel.setAttribute('hidden', 'hidden');
                });
                items.forEach(function (item) {
                    var on = item.getAttribute('data-section-item') === id;
                    item.className = on ? 'active' : '';
                    item.querySelector('a').setAttribute('aria-current', on ? 'page' : 'false');
                });
            }

            function fromHash() {
                var id = decodeURIComponent(window.location.hash.replace(/^#/, ''));
                if (id && exists(id)) show(id);
            }

            items.forEach(function (item) {
                item.querySelector('a').addEventListener('click', function (event) {
                    if (event.ctrlKey || event.metaKey || event.shiftKey || event.button) return;
                    event.preventDefault();
                    var id = item.getAttribute('data-section-item');
                    show(id);
                    history.replaceState(null, '', window.location.pathname + '#' + id);
                });
            });

            window.addEventListener('hashchange', fromHash);
            // A failed save or a connection test is shown where it happened; otherwise the fragment (a saved section) wins.
            if (host.getAttribute('data-locked') !== 'true') fromHash();
        })();
    </script>
    <script>
        // The "Copy all data" option applies only to a relational target; it is hidden (and not posted) for any other type.
        (function () {
            var option = document.getElementById('copy-option');
            var select = document.getElementById('Database_Type');
            if (!option || !select) return;

            var types = (option.getAttribute('data-target-types') || '').toLowerCase().split(',');
            var box = option.querySelector('input[type=checkbox]');

            function update() {
                var relational = types.indexOf(String(select.value).toLowerCase()) >= 0;
                if (relational) option.removeAttribute('hidden'); else option.setAttribute('hidden', 'hidden');
                box.disabled = !relational;
            }

            select.addEventListener('change', update);
            update();
        })();

        // Polls the copy's progress while it runs. Text only (textContent): nothing is parsed as markup.
        (function () {
            var panel = document.getElementById('copy-status');
            if (!panel || panel.getAttribute('data-active') !== 'true') return;

            function show(name, text) {
                var element = panel.querySelector('[' + name + ']');
                if (element) element.textContent = text;
            }

            function poll() {
                fetch('?handler=CopyStatus', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                    .then(function (response) { return response.ok ? response.json() : null; })
                    .then(function (status) {
                        if (!status) { setTimeout(poll, 2000); return; }

                        show('data-copy-phase', status.phase);
                        show('data-copy-message', status.message || '');
                        show('data-copy-progress', status.phase === 'Copying'
                            ? status.table + ': ' + status.tableRowsCopied + ' of ' + status.tableRowsTotal + ' rows; ' + status.rowsCopied + ' of ' + status.rowsTotal + ' in all.'
                            : '');

                        var errors = panel.querySelector('[data-copy-errors]');
                        errors.textContent = '';
                        (status.errors || []).forEach(function (error) {
                            var item = document.createElement('li');
                            item.textContent = error;
                            errors.appendChild(item);
                        });

                        if (status.finished) { window.location.reload(); return; }
                        setTimeout(poll, 2000);
                    })
                    .catch(function () { setTimeout(poll, 2000); });
            }

            setTimeout(poll, 2000);
        })();
    </script>
    <script>
        // Rewrites the example of a setting (placeholder and help line) when the setting that selects it
        // changes. Text only (textContent / setAttribute): nothing is parsed as markup, no request is sent,
        // and no field value is touched.
        (function () {
            function parse(text) {
                try { return JSON.parse(text || '{}') || {}; } catch (e) { return {}; }
            }

            document.querySelectorAll('[data-example-source]').forEach(function (line) {
                var source = document.getElementById(line.getAttribute('data-example-source'));
                var input = document.getElementById(line.getAttribute('data-example-target'));
                if (!source) return;

                var examples = parse(line.getAttribute('data-examples'));
                var stored = line.getAttribute('data-example-stored') === 'true';

                function update() {
                    var value = source.value;
                    var key = String(value).toLowerCase();
                    var hasExample = Object.prototype.hasOwnProperty.call(examples, key);
                    var example = hasExample ? String(examples[key]) : null;

                    line.querySelector('[data-example-type]').textContent = value;
                    line.querySelector('[data-example-text]').textContent = hasExample ? example : '';
                    if (hasExample) line.removeAttribute('hidden'); else line.setAttribute('hidden', 'hidden');

                    if (input && !stored) {
                        input.setAttribute('placeholder', hasExample ? 'e.g. ' + example : 'not set');
                    }
                }

                source.addEventListener('change', update);
            });
        })();
    </script>
}
