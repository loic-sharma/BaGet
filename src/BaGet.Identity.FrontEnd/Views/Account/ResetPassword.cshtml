@model BaGet.Identity.Application.Models.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="col-sm-6">
    <h1>Reset password</h1>
    <hr class="breadcrumb-divider" />

    @if (Model.Error != null)
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    @if (Model.LinkIsUsable)
    {
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Code" />
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Reset password</button>
        </form>
    }
</div>
