@model BaGet.Identity.Application.Models.Account.ReauthenticateViewModel
@{
    ViewData["Title"] = "Confirm it is you";
}

<div class="col-sm-6">
    <h1>Confirm it is you</h1>
    <hr class="breadcrumb-divider" />

    @if (Model.Error != null)
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }
    @if (Model.Providers is { Count: > 0 })
    {
        <p>Which provider do you want to sign in again with?</p>
        <form method="post" asp-controller="Account" asp-action="Reauthenticate">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            @foreach (var provider in Model.Providers)
            {
                <button type="submit" name="provider" value="@provider.Id" class="btn btn-default" data-provider="@provider.Id">Sign in again with @provider.DisplayName</button>
            }
        </form>
    }
    <p><a href="@Url.Action("Settings", "AccountSettings")">Back to account settings</a></p>
</div>
