@model BaGet.Identity.Application.Models.Shared.ConfirmPasswordView

@if (Model.HasPassword)
{
    <div class="form-group">
        <label for="@Model.Id">Your password</label>
        <input id="@Model.Id" name="password" type="password" class="form-control" autocomplete="current-password" />
    </div>
}
else
{
    <partial name="~/Views/Shared/_Reauthenticate.cshtml" model="@(new ReauthenticateView(Model.Reauthenticated, Model.CanReauthenticate, Model.ReturnPage))" />
}
