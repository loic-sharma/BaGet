@model BaGet.Identity.Application.Models.Policies.RetentionFieldsView
@{
    var f = Model.Form;
    var p = Model.IdPrefix;
}

<div class="form-group">
    <label for="@p-name">Name</label>
    <input id="@p-name" name="Form.Name" type="text" class="form-control" value="@f.Name" maxlength="@BaGet.Core.AccessNames.MaxLength" autocomplete="off" />
</div>
<div class="form-group">
    <label for="@p-kind">Applies to</label>
    <select id="@p-kind" name="Form.ScopeKind" class="form-control">
        <option value="repository" selected="@(f.ScopeKind != "project")">one repository</option>
        <option value="project" selected="@(f.ScopeKind == "project")">every repository of a project</option>
    </select>
</div>
<div class="form-group">
    <label for="@p-scope">Repository or project</label>
    <input id="@p-scope" name="Form.ScopeName" type="text" class="form-control" value="@f.ScopeName" list="@p-scope-list" autocomplete="off" />
    <datalist id="@p-scope-list">
        @foreach (var repository in Model.Repositories)
        {
            <option value="@repository.Name">repository, @repository.Format @repository.Kind</option>
        }
        @foreach (var project in Model.Projects)
        {
            <option value="@project">project</option>
        }
    </datalist>
    <span class="help-block">Virtual repositories store nothing, so no policy applies to them.</span>
</div>
<div class="form-group">
    <label for="@p-patterns">Only these artifacts (optional)</label>
    <textarea id="@p-patterns" name="Form.NamePatterns" rows="2" class="form-control" placeholder="Contoso.*">@f.NamePatterns</textarea>
    <span class="help-block">Globs with <code>*</code>, one per line, for package ids, npm names, Maven <code>group:artifact</code> or Docker images. Empty: every artifact.</span>
</div>

<h4>Rules</h4>
<p class="help-block">A version is deleted when any rule selects it and no legal hold covers it. Leave a rule empty to switch it off.</p>
<div class="form-group">
    <label for="@p-keep">Keep the newest (versions per artifact)</label>
    <input id="@p-keep" name="Form.KeepLast" type="number" min="1" class="form-control" value="@f.KeepLast" />
</div>
<div class="form-group">
    <label for="@p-age">Delete versions older than (days)</label>
    <input id="@p-age" name="Form.OlderThanDays" type="number" min="1" class="form-control" value="@f.OlderThanDays" />
</div>
<div class="form-group">
    <label for="@p-unused">Delete versions not downloaded for (days)</label>
    <input id="@p-unused" name="Form.UnusedDays" type="number" min="1" class="form-control" value="@f.UnusedDays" />
    <span class="help-block">Counts from the last recorded download, or from the publish time when none was recorded (downloads before this feature are not known).</span>
</div>
<div class="checkbox">
    <label><input id="@p-prerelease" name="Form.PrereleaseOnly" type="checkbox" value="true" checked="@f.PrereleaseOnly" /> The age rules and the newest-versions rule look at prerelease versions only (NuGet pre-release, npm prerelease, Maven snapshot)</label>
</div>
<div class="form-group">
    <label for="@p-cache">Remote cache limit (MiB)</label>
    <input id="@p-cache" name="Form.CacheLimitMb" type="number" min="1" class="form-control" value="@f.CacheLimitMb" />
    <span class="help-block">Remote repositories only: the least recently used cached versions are deleted until the cache fits.</span>
</div>
<div class="form-group">
    <label for="@p-untagged">Docker: delete manifests untagged for more than (days)</label>
    <input id="@p-untagged" name="Form.UntaggedAfterDays" type="number" min="0" class="form-control" value="@f.UntaggedAfterDays" />
    <span class="help-block">Counted from the push. Manifests an index or a referrer relationship still needs are kept.</span>
</div>
<div class="checkbox">
    <label><input id="@p-gc" name="Form.CollectGarbage" type="checkbox" value="true" checked="@f.CollectGarbage" /> Docker: run the garbage collection afterwards (frees the blobs nothing references)</label>
</div>

<h4>When</h4>
<div class="form-group">
    <label for="@p-schedule">Run automatically every (hours)</label>
    <input id="@p-schedule" name="Form.ScheduleHours" type="number" min="1" class="form-control" value="@f.ScheduleHours" />
    <span class="help-block">Empty: only when you press <em>Run now</em>. Scheduled runs happen only while the policy is enabled, and wait while the server is read-only.</span>
</div>
<div class="checkbox">
    <label><input id="@p-enabled" name="Form.Enabled" type="checkbox" value="true" checked="@f.Enabled" /> Enabled (a disabled policy only reports in a dry run)</label>
</div>
