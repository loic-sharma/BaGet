@model BaGet.Web.Application.Models.Npm.NpmPackagesViewModel

@{
    ViewData["Title"] = "npm packages";
    ViewData["HideSearchBar"] = true;
}

<div class="col-sm-12" id="npm-packages">
    <h1>npm packages</h1>
    <hr class="breadcrumb-divider" />

    <form action="@Url.Action("Packages", "NpmBrowse")" method="get" class="home-search" id="npm-search-form">
        <div class="input-group">
            <input type="text" name="q" value="@Model.Query" class="form-control" autocomplete="off" placeholder="Search npm packages by name..." />
            <span class="input-group-btn">
                <button type="submit" class="btn btn-default" title="Search for packages">
                    <span class="ms-Icon ms-Icon--Search" aria-hidden="true"></span>
                </button>
            </span>
        </div>
    </form>

    <p id="npm-registry-url">
        Registry: <code>@Model.RegistryUrl</code>
        &middot; <code>npm config set registry @Model.RegistryUrl</code>
        &middot; <a asp-controller="NpmBrowse" asp-action="Upload">Upload a package</a>
    </p>

    @if (Model.Result.Hits.Count == 0)
    {
        <div id="npm-no-results">
            <h2>Oops, nothing here...</h2>
            <p>
                @(string.IsNullOrWhiteSpace(Model.Query) ? "This registry holds no package yet." : "No package name contains that text.")
                Publish one with <code>npm publish --registry=@Model.RegistryUrl</code>, or <a asp-controller="NpmBrowse" asp-action="Upload">upload a tarball</a>.
            </p>
        </div>
    }
    else
    {
        <p class="text-muted" id="npm-total">@Model.Result.Total package@(Model.Result.Total == 1 ? "" : "s")</p>

        <div class="search-results">
            @foreach (var hit in Model.Result.Hits)
            {
                <div class="search-result package-card" data-package="@hit.Name">
                    <div class="card-body">
                        <div class="card-heading">
                            <a asp-controller="NpmBrowse" asp-action="Package" asp-route-id="@hit.Name" class="package-title">@hit.Name</a>
                        </div>
                        <ul class="info">
                            @if (hit.Version != null)
                            {
                                <li><span><i class="ms-Icon ms-Icon--Flag"></i> Latest version: @hit.Version</span></li>
                            }
                            <li>
                                <span class="last-updated" title="@hit.Modified.ToString("u")">
                                    <i class="ms-Icon ms-Icon--Calendar"></i> Last updated @hit.Modified.Humanize()
                                </span>
                            </li>
                            @if (hit.Keywords.Count > 0)
                            {
                                <li><span class="tags"><i class="ms-Icon ms-Icon--Tag"></i> @string.Join(" ", hit.Keywords)</span></li>
                            }
                        </ul>
                        <div class="card-description">@hit.Description</div>
                    </div>
                </div>
            }
        </div>

        @if (Model.PageIndex > 1 || Model.HasNext)
        {
            <nav aria-label="Search page navigation">
                <ul class="pager">
                    @if (Model.PageIndex > 1)
                    {
                        <li><a href="@Url.Action("Packages", "NpmBrowse", new { q = Model.Query, p = Model.PageIndex - 1 })">Previous</a></li>
                    }

                    @if (Model.HasNext)
                    {
                        <li><a href="@Url.Action("Packages", "NpmBrowse", new { q = Model.Query, p = Model.PageIndex + 1 })">Next</a></li>
                    }
                </ul>
            </nav>
        }
    }
</div>
