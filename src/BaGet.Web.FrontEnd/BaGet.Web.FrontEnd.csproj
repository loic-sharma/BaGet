<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PackageTags>NuGet</PackageTags>
    <Description>BaGet Extension's package browsing screens: the view controllers and views of the home, package, upload, statistics and format browse pages, and AddBaGetFrontEnd.</Description>
    <RootNamespace>BaGet.Web.V3</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8620</NoWarn>
    <PackageId>Extension.$(MSBuildProjectName)</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Microsoft.Build.Tasks.Git" Version="10.0.402" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaGet.Frontend.Base\BaGet.Frontend.Base.csproj" />
    <ProjectReference Include="..\BaGet.Web.V3\BaGet.Web.V3.csproj" />
    <ProjectReference Include="..\BaGet.Identity.FrontEnd\BaGet.Identity.FrontEnd.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BaGet.Tests" Key="$(BaGetPublicKey)" />
    <InternalsVisibleTo Include="BaGet.Web.Tests" Key="$(BaGetPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The views are compiled into this assembly; their .cshtml are not deployment files. Publishing them would
         collide with the other Razor libraries' Views/_ViewImports.cshtml (NETSDK1152). -->
    <Content Update="Views\**\*.cshtml" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
